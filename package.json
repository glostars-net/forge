{
  "name": "forge-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "aj's OpenCode plan-execution desk",
  "bin": {
    "forge": "./index.ts"
  },
  "scripts": {
    "start": "bun index.ts",
    "install:cli": "bun install -g . && mkdir -p \"$HOME/.local/bin\" && ln -sf \"$HOME/.bun/bin/forge\" \"$HOME/.local/bin/forge\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.9.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
